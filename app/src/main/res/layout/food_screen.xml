<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FoodScreen">

    <LinearLayout
        android:id="@+id/eat_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#F2FCE2"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/nav"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/text_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/main_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="39dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Каталог еды"
                android:textColor="#4CAF50"
                android:textSize="24sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="333dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="39dp"
            android:layout_marginEnd="39dp"
            android:background="@drawable/search_view_bd"
            app:iconifiedByDefault="false"
            app:queryHint="Введите название..."/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/cards_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="333dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="17dp"
                    android:layout_marginStart="38dp"
                    android:background="@drawable/border_radius"
                    android:elevation="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="49dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:text="Куринная грудка"
                            android:textColor="#39843D" />

                        <TextView
                            android:id="@+id/textView5"
                            android:layout_width="5dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:layout_weight="1"
                            android:text="165 ккал"
                            android:textColor="#4CAF50" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginTop="14dp"
                            android:layout_marginStart="15dp"
                            android:text="на 100г"
                            android:textColor="#63676E" />

                        <TextView
                            android:id="@+id/textView7"
                            android:layout_width="83dp"
                            android:layout_marginTop="14dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="P: 31г | C: 0г | F: 3.6г"
                            android:textColor="#63676E" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


        </ScrollView>
    </LinearLayout>

    <!-- Нижняя навигационная панель (оставить без изменений) -->
    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/img_nav"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityHome"
                app:srcCompat="@drawable/home_icon" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityCalculator"
                app:srcCompat="@drawable/calculator_icon" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/apple_green" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityMap"
                app:srcCompat="@drawable/icon_map" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                app:srcCompat="@drawable/icon_user" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/text_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityHome"
                android:text="Главная"
                android:textAlignment="center"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityCalculator"
                android:text="Калькулятор"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:text=" Еда  "
                android:textAlignment="center"
                android:textColor="#4CAF50"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityMap"
                android:text="   Магазины"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                android:text="Профиль"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>