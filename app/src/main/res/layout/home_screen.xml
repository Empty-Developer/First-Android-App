<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeScreen">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/main_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2FCE2"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="304dp"
                android:background="@drawable/image_1"
                android:orientation="vertical">

                <Space
                    android:id="@+id/header_space"
                    android:layout_width="match_parent"
                    android:layout_height="198dp" />

                <TextView
                    android:id="@+id/header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="true"
                    android:text="Еда - Жизнь"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/header_text_litl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="Отслеживай свой путь к питанию"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/center_layout"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/main_center"
                    android:layout_width="333dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="35dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/border_radius"
                    android:elevation="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/one_main_center"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/glass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/material_symbols_water_full_rounded" />

                        <TextView
                            android:id="@+id/main_information"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Дневная норма воды"
                            android:textColor="#4CAF50"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/move_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:layout_weight="0.1"
                            android:fontFamily="sans-serif-medium"
                            android:text="0"
                            android:textColor="#EF4444"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/number_information"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="/ 8"
                            android:textColor="#EF4444"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/twoo_main_center"
                        android:layout_width="match_parent"
                        android:layout_height="78dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/minus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            android:onClick="minusImg"
                            app:srcCompat="@drawable/frame_2" />

                        <ImageView
                            android:id="@+id/cell_1"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/cell_2"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/cell_3"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/cell_4"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/cell_5"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/cell_6"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/cell_7"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/cell_8"
                            android:layout_width="18dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            app:srcCompat="@drawable/rectangle" />

                        <ImageView
                            android:id="@+id/plus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="11dp"
                            android:layout_weight="1"
                            android:onClick="plusImg"
                            app:srcCompat="@drawable/frame_1" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tree_main_center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/down_text_center"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-light"
                            android:text="Дневная норма: 8 стаканов"
                            android:textAlignment="center"
                            android:textColor="#767E89"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lower_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_lower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="31dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Наши возможности"
                    android:textColor="#4CAF50"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/Top_blok"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/one_blok"
                        android:layout_width="205dp"
                        android:layout_height="199dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/blok_calculator"
                            android:layout_width="160dp"
                            android:layout_height="170dp"
                            android:layout_marginStart="29dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/border_radius"
                            android:elevation="4dp"
                            android:onClick="startActivityCalculator"
                            android:orientation="vertical"
                            android:outlineProvider="background">

                            <ImageView
                                android:id="@+id/calculator_in_blok"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="15dp"
                                app:srcCompat="@drawable/lucide_calculator" />

                            <TextView
                                android:id="@+id/calculator_text_main"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:onClick="startActivityCalculator"
                                android:text="Калькулятор\nкаллорий"
                                android:textColor="#4CAF50"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/calculator_textOne"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:onClick="startActivityCalculator"
                                android:text="Отслеживайте\nежедневное\nпотребление\nкаллорий"
                                android:textColor="#6B7280"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/twoo_blok"
                        android:layout_width="205dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/blok_map"
                            android:layout_width="160dp"
                            android:layout_height="170dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/border_radius"
                            android:elevation="4dp"
                            android:onClick="startActivityMap"
                            android:orientation="vertical"
                            android:outlineProvider="background">

                            <ImageView
                                android:id="@+id/map_in_blok"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="15dp"
                                app:srcCompat="@drawable/lucide_map" />

                            <TextView
                                android:id="@+id/map_text_main"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:onClick="startActivityMap"
                                android:text="Карта магазинов"
                                android:textColor="#4CAF50"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/map_textOne"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:onClick="startActivityMap"
                                android:text="Найдем магазин\nздрового питания\nрядом с вами"
                                android:textColor="#6B7280"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/Down_blok"
                    android:layout_width="match_parent"
                    android:layout_height="198dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tree_blok"
                        android:layout_width="205dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/blok_eat"
                            android:layout_width="160dp"
                            android:layout_height="170dp"
                            android:layout_marginStart="29dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/border_radius"
                            android:elevation="4dp"
                            android:onClick="startActivityFood"
                            android:orientation="vertical"
                            android:outlineProvider="background">

                            <ImageView
                                android:id="@+id/eat_in_blok"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="15dp"
                                app:srcCompat="@drawable/icon_park_outline_apple_one" />

                            <TextView
                                android:id="@+id/eat_text_main"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:onClick="startActivityFood"
                                android:text="Каталог еды"
                                android:textColor="#4CAF50"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/eat_textOne"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:onClick="startActivityFood"
                                android:text="Предоставим вам\nнаш архив\nполездных блюд"
                                android:textColor="#6B7280"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/four_blok"
                        android:layout_width="205dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/blok_profile"
                            android:layout_width="160dp"
                            android:layout_height="170dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/border_radius"
                            android:elevation="4dp"
                            android:onClick="startActivityUser"
                            android:orientation="vertical"
                            android:outlineProvider="background">

                            <ImageView
                                android:id="@+id/profile_in_blok"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="15dp"
                                app:srcCompat="@drawable/lucide_user" />

                            <TextView
                                android:id="@+id/profile_text_main"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:onClick="startActivityUser"
                                android:text="Персональный\nПрофиль"
                                android:textColor="#4CAF50"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/profile_textOne"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="15dp"
                                android:layout_marginTop="10dp"
                                android:onClick="startActivityUser"
                                android:text="Возможность\nизминить свои\nперсональные\nданные"
                                android:textColor="#6B7280"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/button"
                    android:layout_width="350dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="31dp"
                    android:layout_marginBottom="130dp"
                    android:backgroundTint="#4CAF50"
                    android:fontFamily="sans-serif-medium"
                    android:onClick="startActivityCalculator"
                    android:text="Начать считать"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/img_nav"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                app:srcCompat="@drawable/home_green" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityCalculator"
                app:srcCompat="@drawable/calculator_icon" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityFood"
                app:srcCompat="@drawable/icon_apple" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityMap"
                app:srcCompat="@drawable/icon_map" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                app:srcCompat="@drawable/icon_user" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/text_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:text="Главная"
                android:textAlignment="center"
                android:textColor="#4CAF50" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityCalculator"
                android:text="Калькулятор"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityFood"
                android:text=" Еда  "
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityMap"
                android:text="   Магазины"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                android:text="Профиль"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>