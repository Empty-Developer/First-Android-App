<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MapScreen">

    <!-- Добавляем фоновый слой для тени -->

    <LinearLayout
        android:id="@+id/map_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2FCE2"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/text_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/main_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="39dp"
                android:layout_marginTop="71dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Магазины"
                android:textColor="#4CAF50"
                android:textSize="24dp" />
        </LinearLayout>

        <com.yandex.mapkit.mapview.MapView
            android:id="@+id/map"
            android:layout_width="332dp"
            android:layout_height="400dp"
            android:layout_marginStart="39dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/border_radius"
            android:elevation="4dp"
            android:outlineProvider="background"/>

        <LinearLayout
            android:id="@+id/mapLayaut"
            android:layout_width="333dp"
            android:layout_height="128dp"
            android:layout_marginStart="39dp"
            android:background="@drawable/border_radius"
            android:elevation="4dp"
            android:orientation="vertical"
            android:outlineProvider="background">

            <TextView
                android:id="@+id/textinformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-medium"
                android:text="Информация о магазине"
                android:textColor="#39843D"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textinformationTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:text="Понедельник - Воскресенье: 7:00 - 23:00\nОстановка: Сибирский институт искусств"
                android:textColor="#63676E"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/img_nav"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityHome"
                app:srcCompat="@drawable/home_icon" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityCalculator"
                app:srcCompat="@drawable/calculator_icon" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityFood"
                app:srcCompat="@drawable/icon_apple" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/map_green" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                app:srcCompat="@drawable/icon_user" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/text_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityHome"
                android:text="Главная"
                android:textAlignment="center"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityCalculator"
                android:text="Калькулятор"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityFood"
                android:text=" Еда  "
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:text="   Магазины"
                android:textAlignment="center"
                android:textColor="#4CAF50"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                android:text="Профиль"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>