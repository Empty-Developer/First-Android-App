<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CalculatorScreen">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/calculator_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F2FCE2"
            android:orientation="vertical">

            <!-- Заголовок -->
            <LinearLayout
                android:id="@+id/text_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="39dp"
                    android:layout_marginTop="71dp"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Калькулятор Калорий"
                    android:textColor="#4CAF50"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Основной контейнер калькулятора -->
            <LinearLayout
                android:id="@+id/calculatorLayout"
                android:layout_width="333dp"
                android:layout_height="624dp"
                android:layout_marginStart="39dp"
                android:layout_marginEnd="39dp"
                android:layout_marginBottom="50dp"
                android:background="@drawable/border_radius"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- Поле для веса -->
                <TextView
                    android:id="@+id/weightLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="30dp"
                    android:text="Вес (кг)"
                    android:textColor="#1C232D"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/weightInput"
                    android:layout_width="292dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border"
                    android:inputType="numberDecimal"
                    android:padding="16dp" />

                <!-- Поле для роста -->
                <TextView
                    android:id="@+id/heightLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="15dp"
                    android:text="Рост (см)"
                    android:textColor="#1C232D"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/heightInput"
                    android:layout_width="292dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border"
                    android:inputType="number"
                    android:padding="16dp" />

                <!-- Поле для возраста -->
                <TextView
                    android:id="@+id/ageLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="15dp"
                    android:text="Возраст"
                    android:textColor="#1C232D"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/ageInput"
                    android:layout_width="292dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/border"
                    android:inputType="number"
                    android:padding="16dp" />

                <!-- Выбор пола -->
                <TextView
                    android:id="@+id/genderLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="15dp"
                    android:text="Пол"
                    android:textColor="#1C232D"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="292dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="10dp">

                    <AutoCompleteTextView
                        android:id="@+id/genderInput"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/search_view_bd"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Выбор образа жизни -->
                <TextView
                    android:id="@+id/lifestyleLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="15dp"
                    android:text="Образ жизни"
                    android:textColor="#1C232D"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="292dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="10dp">

                    <AutoCompleteTextView
                        android:id="@+id/lifestyleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/search_view_bd"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Кнопка расчета -->
                <Button
                    android:id="@+id/calculateButton"
                    android:layout_width="292dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="21dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#4CAF50"
                    android:text="Посчитать"
                    android:textAllCaps="false" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="150dp" />

            <!-- Закрываем calculatorLayout -->

        </LinearLayout> <!-- Закрываем calculator_layout -->

    </ScrollView>


    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="139dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/img_nav"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityHome"
                app:srcCompat="@drawable/home_icon" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/calculator_green" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityFood"
                app:srcCompat="@drawable/icon_apple" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityMap"
                app:srcCompat="@drawable/icon_map" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                app:srcCompat="@drawable/icon_user" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/text_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityHome"
                android:text="Главная"
                android:textAlignment="center"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:text="Калькулятор"
                android:textAlignment="center"
                android:textColor="#4CAF50"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityFood"
                android:text=" Еда  "
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityMap"
                android:text="   Магазины"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:layout_weight="1"
                android:onClick="startActivityUser"
                android:text="Профиль"
                android:textAlignment="center"
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

